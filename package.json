{
  "name": "urajs",
  "version": "1.0.0",
  "description": "frontend framework",
  "type": "module",
  "scripts": {
    "start": "node ./scripts/commands/dev.ts",
    "route": "node ./scripts/commands/route.ts",
    "comp": "node ./scripts/commands/comp.ts",
    "clear": "rm -rf ./out/*",
    "build": "node ./scripts/commands/build.ts",
    "config": "node ./scripts/commands/config.ts",
    "reset": "node ./scripts/commands/reset.ts",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json"
  },
  "author": "Hrima Mohammed",
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22"
  },
  "optionalDependencies": {
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "sass": "^1.80.6",
    "tailwindcss": "^3.4.15"
  }
}
